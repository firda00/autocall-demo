# AutoCall Standalone Configuration

# Port & Host
PORT=4600
HOST=127.0.0.1

# Telephony Provider: "demo" (default simulation, zero cost) OR "onlinepbx" (real calls)
AUTOCALL_PROVIDER=demo

# Timezone (Tashkent is UTC+5)
AUTOCALL_TZ=Asia/Tashkent

# Optional security token for API
# AUTOCALL_ADMIN_TOKEN=your-secret-token

# -------------------------------------------------------------
# onlinePBX Integration (Required ONLY if AUTOCALL_PROVIDER=onlinepbx)
# -------------------------------------------------------------
# AUTOCALL_REAL_CALLS_CONFIRMED=true
# ONLINEPBX_DOMAIN=pbx12345.onpbx.ru
# ONLINEPBX_API_KEY=your_api_key_from_onlinepbx
# ONLINEPBX_GATE_FROM=998711234567
# ONLINEPBX_DISPLAY_NAME=U-STUDY
# ONLINEPBX_POLL_SECONDS=4
